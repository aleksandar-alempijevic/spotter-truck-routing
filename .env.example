# Copy to .env (git-ignored). Nothing here is needed for `make backend` locally;
# it exists for the settings production uses and for the API keys later milestones add.

# Django — production only (local runs set DJANGO_DEBUG=1 themselves)
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Routing and geocoding providers (not used yet)
TOMTOM_API_KEY=
GEOAPIFY_API_KEY=
