# Copy to .env (git-ignored). Nothing here is needed for `make backend` locally;
# it exists for the settings production uses and for the provider keys.

# Django — production only (local runs set DJANGO_DEBUG=1 themselves)
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Routing provider (TomTom Routing; the routes endpoint answers 503 without it)
TOMTOM_API_KEY=

# Address-search provider (Geoapify; the address-search endpoint answers 503 without it)
GEOAPIFY_API_KEY=
